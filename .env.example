# LLM provider: "anthropic" or "mock" (mock needs no key, used for evaluation/CI)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Storage and limits
DATA_DIR=./data/runtime
MAX_UPLOAD_MB=50
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=20

# HTTP API (optional): if set, every request needs "Authorization: Bearer <token>". Identity comes from the X-Owner-Id header.
API_TOKEN=
